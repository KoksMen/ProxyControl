<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Modern Fluent Color Palette (Dark)  -->
    <Color x:Key="PrimaryAccent">#6366F1</Color>
    <Color x:Key="SecondaryAccent">#8B5CF6</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>

    <!--  Elevated Layer Surfaces  -->
    <Color x:Key="SurfaceDark">#0C0D11</Color>
    <Color x:Key="SurfaceMedium">#14151B</Color>
    <Color x:Key="SurfaceLight">#1D1F28</Color>
    <Color x:Key="BorderColor">#2B2E3C</Color>

    <!--  Refined Text & Icon Colors  -->
    <Color x:Key="Foreground">#F3F4F6</Color>
    <Color x:Key="ForegroundMuted">#7E8398</Color>
    <Color x:Key="ForegroundSubtle">#9CA1B7</Color>
    <Color x:Key="ForegroundDisabled">#4B4F63</Color>
    <Color x:Key="IconColor">#9CA1B7</Color>

    <!--  Brushes  -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccent}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccent}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}" />
    <SolidColorBrush x:Key="SurfaceMediumBrush" Color="{StaticResource SurfaceMedium}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource Foreground}" />
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="{StaticResource ForegroundMuted}" />
    <SolidColorBrush x:Key="ForegroundSubtleBrush" Color="{StaticResource ForegroundSubtle}" />
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="{StaticResource ForegroundDisabled}" />
    <SolidColorBrush x:Key="IconBrush" Color="{StaticResource IconColor}" />

    <!--  Modern Gradients  -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6366F1" />
        <GradientStop Offset="1" Color="#7C3AED" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#14151B" />
        <GradientStop Offset="1" Color="#0C0D11" />
    </LinearGradientBrush>

    <!--  Clean Minimal ScrollBar  -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#34384A" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#4E536B" />
    <SolidColorBrush x:Key="ScrollBarThumbDragBrush" Color="#676E8E" />
    <SolidColorBrush x:Key="ScrollBarTrackBorderBrush" Color="Transparent" />

    <Style x:Key="MinimalScrollRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MinimalScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        x:Name="ThumbVisual"
                        Margin="2,1"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource ScrollBarThumbDragBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalMinimalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Width="{TemplateBinding Width}" Background="Transparent" SnapsToDevicePixels="True">
            <Border
                Margin="0"
                Background="{DynamicResource ScrollBarTrackBrush}"
                BorderThickness="0"
                Opacity="1" />
            <Track
                x:Name="PART_Track"
                Margin="1,0"
                Focusable="False"
                IsDirectionReversed="True"
                Orientation="Vertical">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource MinimalScrollRepeatButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="24" Style="{StaticResource MinimalScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource MinimalScrollRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalMinimalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Height="{TemplateBinding Height}" Background="Transparent" SnapsToDevicePixels="True">
            <Border
                Margin="0"
                Background="{DynamicResource ScrollBarTrackBrush}"
                BorderThickness="0"
                Opacity="1" />
            <Track
                x:Name="PART_Track"
                Margin="0,1"
                Focusable="False"
                IsDirectionReversed="False"
                Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource MinimalScrollRepeatButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="24" Style="{StaticResource MinimalScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource MinimalScrollRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}" />
        <Setter Property="Template" Value="{StaticResource VerticalMinimalScrollBarTemplate}" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10" />
                <Setter Property="Cursor" Value="SizeNS" />
                <Setter Property="Template" Value="{StaticResource VerticalMinimalScrollBarTemplate}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="Cursor" Value="SizeWE" />
                <Setter Property="Template" Value="{StaticResource HorizontalMinimalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Modern ToolTip Style  -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="#171821" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
