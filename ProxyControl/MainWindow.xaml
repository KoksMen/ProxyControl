                                                                FontSize="11"
                                                                Style="{StaticResource AccentBtn}"
                                                                ToolTip="Create Traffic Rule" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

