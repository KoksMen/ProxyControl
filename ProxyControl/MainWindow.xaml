                                            <CheckBox
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsDnsProtectionEnabled}"
                                                Style="{StaticResource ToggleSwitchStyle}" />
                                        </Grid>

                                        <!--  DNS Settings (Visible if Enabled)  -->
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDnsProtectionEnabled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                Margin="0,0,0,5"
                                                Foreground="#AAA"
                                                Text="DNS Provider:" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox
                                                    DisplayMemberPath="."
                                                    ItemsSource="{Binding DnsProviders}"
                                                    SelectedItem="{Binding SelectedDnsProvider}" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock
                                                        Margin="0,0,0,4"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource ForegroundMutedBrush}"
                                                        Text="Primary DNS" />
                                                    <TextBox
                                                        IsEnabled="{Binding IsDnsCustom}"
                                                        Text="{Binding DnsHost, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="DNS server IP or domain, e.g. 8.8.8.8 or dns.google" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock
                                                        Margin="0,0,0,4"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource ForegroundMutedBrush}"
                                                        Text="Alternative DNS" />
                                                    <TextBox
                                                        IsEnabled="{Binding IsDnsCustom}"
                                                        Text="{Binding DnsFallbackHost, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="Fallback DNS server IP or domain" />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox
                                                Margin="0,10,0,0"
                                                VerticalAlignment="Center"
                                                Content="Use alternative DNS only when primary fails"
                                                IsChecked="{Binding PreferPrimaryDns}"
                                                ToolTip="Enabled: query the primary DNS first and use the alternative only after a timeout or DNS error. Disabled: query both servers in parallel and use the fastest valid response." />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Margin="0,0,5,0"
                                                    Padding="9,7"
                                                    Background="#242A36"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource ForegroundBrush}"
                                                                Text="Primary DNS" />
                                                            <TextBlock
                                                                Margin="0,2,8,0"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                Text="{Binding PrimaryDnsStatusDetails}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding PrimaryDnsStatus, Converter={StaticResource StatusColor}}"
                                                            Text="{Binding PrimaryDnsStatus}" />
                                                    </Grid>
                                                </Border>
                                                <Border
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    Padding="9,7"
                                                    Background="#242A36"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource ForegroundBrush}"
                                                                Text="Alternative DNS" />
                                                            <TextBlock
                                                                Margin="0,2,8,0"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                Text="{Binding FallbackDnsStatusDetails}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding FallbackDnsStatus, Converter={StaticResource StatusColor}}"
                                                            Text="{Binding FallbackDnsStatus}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource ForegroundMutedBrush}"
                                                    Text="{Binding DohSaveStatus}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Grid.Column="1"
                                                    Height="32"
                                                    Margin="0,0,8,0"
                                                    Padding="14,0"
                                                    Command="{Binding CheckDnsCommand}"
                                                    Content="Check DNS"
                                                    Cursor="Hand"
                                                    IsEnabled="{Binding IsDnsCheckInProgress, Converter={StaticResource InvBool}}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Height="32"
                                                    Padding="14,0"
                                                    Background="#3A6FF8"
                                                    BorderThickness="0"
                                                    Command="{Binding SaveChangesCommand}"
                                                    Content="Save DNS"
                                                    Cursor="Hand"
                                                    Foreground="White" />
                                            </Grid>
                                            <!-- DoH functionality disabled by request.
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource ForegroundBrush}"
                                                        Text="DNS over HTTPS (DoH)" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{DynamicResource ForegroundMutedBrush}"
                                                        Text="Encrypt DNS requests through HTTPS when DNS Protection is active" />
                                                </StackPanel>
                                                <CheckBox
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsDohEnabled}"
                                                    Style="{StaticResource ToggleSwitchStyle}" />
                                            </Grid>
                                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDohEnabled, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource ForegroundMutedBrush}"
                                                        Text="Primary DoH" />
                                                    <CheckBox
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Content="Auto"
                                                        IsChecked="{Binding IsDohPrimaryAuto}" />
                                                    <TextBox
                                                        Grid.Column="2"
                                                        Margin="10,0,0,0"
                                                        IsEnabled="{Binding IsDohPrimaryAuto, Converter={StaticResource InvBool}}"
                                                        Text="{Binding DohEndpointInput, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="DoH endpoint, e.g. https://cloudflare-dns.com/dns-query" />
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource ForegroundMutedBrush}"
                                                        Text="Alternative DoH" />
                                                    <CheckBox
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Content="Use"
                                                        IsChecked="{Binding IsDohFallbackEnabled}" />
                                                    <CheckBox
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Content="Auto"
                                                        IsChecked="{Binding IsDohFallbackAuto}" />
                                                    <TextBox
                                                        Grid.Column="3"
                                                        Margin="10,0,0,0"
                                                        IsEnabled="{Binding IsDohFallbackAuto, Converter={StaticResource InvBool}}"
                                                        Text="{Binding DohFallbackEndpointInput, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="Fallback DoH endpoint" />
                                                </Grid>
                                                <TextBlock
                                                    Margin="200,4,0,0"
                                                    FontSize="10"
                                                    Foreground="#FF7777"
                                                    Text="{Binding DohEndpointValidationMessage}" />
                                                <TextBlock
                                                    Margin="200,2,0,0"
                                                    FontSize="10"
                                                    Foreground="#FF7777"
                                                    Text="{Binding DohFallbackEndpointValidationMessage}" />
                                                <TextBlock
                                                    Margin="200,4,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource ForegroundMutedBrush}"
                                                    Text="{Binding DohTransportStatus}"
                                                    TextWrapping="Wrap" />
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource ForegroundMutedBrush}"
                                                        Text="{Binding DohSaveStatus}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Height="32"
                                                        Padding="14,0"
                                                        Background="#3A6FF8"
                                                        BorderThickness="0"
                                                        Command="{Binding SaveChangesCommand}"
                                                        Content="Save DoH"
                                                        Cursor="Hand"
                                                        Foreground="White" />
                                                </Grid>
                                            </StackPanel>
                                            -->
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  WebRTC Protection (Hidden)  -->
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10,8"
                                    Background="{DynamicResource SurfaceLightBrush}"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Text="🌐" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource ForegroundBrush}"
                                                Text="WebRTC Protection" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource ForegroundMutedBrush}"
                                                Text="Prevent IP leaks via WebRTC" />
                                        </StackPanel>
                                        <CheckBox
                                            Grid.Column="2"
                                            IsChecked="{Binding IsWebRtcBlockingEnabled}"
                                            Style="{StaticResource ToggleSwitchStyle}" />
                                    </Grid>
                                </Border>

                                <!--  TUN Mode (Hidden)  -->


                                <!--  Import/Export & Update Actions  -->
                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource ForegroundMutedBrush}"
                                        Text="DATA &amp; UPDATES" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Height="36"
                                            Background="#333"
                                            BorderThickness="0"
                                            Command="{Binding ImportConfigCommand}"
                                            Content="Import Settings"
                                            Cursor="Hand"
                                            Foreground="White" />
                                        <Button
                                            Grid.Column="2"
                                            Height="36"
                                            Background="#333"
                                            BorderThickness="0"
                                            Command="{Binding ExportConfigCommand}"
                                            Content="Export Settings"
                                            Cursor="Hand"
                                            Foreground="White" />
                                    </Grid>

                                    <Border
                                        Padding="12"
                                        Background="{DynamicResource SurfaceLightBrush}"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource ForegroundBrush}"
                                                    Text="{Binding CurrentVersion, StringFormat='Version: {0}'}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource ForegroundMutedBrush}"
                                                    Text="Check for latest release" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Padding="12,6"
                                                Background="#2563EB"
                                                BorderThickness="0"
                                                Command="{Binding CheckUpdateCommand}"
                                                Content="Check Updates"
                                                Cursor="Hand"
                                                Foreground="White"
                                                Style="{StaticResource AccentBtn}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Button
                                    Height="40"
                                    Margin="0,20,0,0"
                                    Command="{Binding ToggleProxyCommand}"
                                    FontSize="14"
                                    FontWeight="Bold">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProxyRunning}" Value="True">
                                                    <Setter Property="Content" Value="SYSTEM PROXY: ON" />
                                                    <Setter Property="Background" Value="#28A745" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsProxyRunning}" Value="False">
                                                    <Setter Property="Content" Value="SYSTEM PROXY: OFF" />
                                                    <Setter Property="Background" Value="#A03333" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                </Button>

                                <Button
                                    Height="40"
                                    Margin="0,10,0,0"
                                    Command="{Binding ExitAppCommand}"
                                    Content="EXIT APPLICATION"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Style="{StaticResource DangerBtn}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="MONITOR" Tag="Monitor">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" MinWidth="320" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.35*" MinWidth="520" />
                            </Grid.ColumnDefinitions>

                            <!--  Left Panel: Process List  -->
                            <Border
                                Grid.Column="0"
                                Margin="0,0,5,0"
                                Style="{StaticResource WorkspaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!--  Header with Filter  -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource ForegroundBrush}"
                                                    Text="Traffic Monitor" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource ForegroundMutedBrush}"
                                                    Text="Live activity grouped by application" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SurfaceLightBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource ForegroundMutedBrush}"
                                                    Text="{Binding MonitoredProcesses.Count, StringFormat='{}{0} apps'}" />
                                            </Border>
                                        </Grid>
                                        <Border
                                            Margin="0,12,0,0"
                                            Padding="8"
                                            Background="#1B1F29"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox
                                                    MinWidth="120"
                                                    Margin="0,0,8,0"
                                                    ItemsSource="{Binding TrafficPeriodModes}"
                                                    SelectedItem="{Binding SelectedPeriodMode}" />
                                                <Button
                                                    Grid.Column="1"
                                                    MinWidth="72"
                                                    Padding="12,6"
                                                    Command="{Binding ApplyFilterCommand}"
                                                    Content="Apply"
                                                    IsEnabled="{Binding IsMonitorPeriodLoading, Converter={StaticResource InvBool}}"
                                                    Style="{StaticResource AccentBtn}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Margin="2,7,0,0"
                                            FontSize="10"
                                            Foreground="{DynamicResource ForegroundMutedBrush}"
                                            Text="{Binding MonitorPeriodStatus}" />
                                        <StackPanel
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal"
                                            Visibility="{Binding IsDateRangeVisible, Converter={StaticResource BoolToVis}}">
                                            <DatePicker
                                                Width="110"
                                                Margin="0,0,8,0"
                                                SelectedDate="{Binding FilterDateStart}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource ForegroundMutedBrush}"
                                                Text="→" />
                                            <DatePicker
                                                Width="110"
                                                Margin="8,0,0,0"
                                                SelectedDate="{Binding FilterDateEnd}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,0,0,8"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource ForegroundMutedBrush}"
                                        Text="APPLICATIONS" />

                                    <!--  Process Cards  -->
                                    <ListBox
                                        Grid.Row="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        ItemsSource="{Binding MonitoredProcesses}"
                                        SelectedItem="{Binding SelectedMonitorProcess}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Cursor="Hand">
                                                        <Border.Style>
                                                            <Style
                                                                BasedOn="{StaticResource DataCardStyle}"
                                                                TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Background" Value="#243A70" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
