                                                Margin="0,0,5,5"
                                                Padding="9,3"
                                                Command="{Binding LoadProfileCommand}"
                                                Content="Activate"
                                                IsEnabled="{Binding HasSelectedProfile}" />
                                            <Button
                                                Margin="0,0,5,5"
                                                Padding="9,3"
                                                Command="{Binding CreateEmptyProfileCommand}"
                                                Content="＋ New Empty"
                                                ToolTip="Create and activate a profile without proxies, rules or presets" />
                                            <Button
                                                Margin="0,0,12,5"
                                                Padding="8,3"
                                                Background="#7F1D1D"
                                                Command="{Binding DeleteProfileCommand}"
